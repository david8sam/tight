{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "allowJs": true,
        "baseUrl": "src",
        "esModuleInterop": true,
        "jsx": "react",
        "lib": ["es6", "dom"],
        "moduleResolution": "node",
        "module": "esnext",
        "noImplicitReturns": true,
        "paths": { "common/*": ["common/*"] },
        "rootDir": ".",
        "sourceMap": true,
        "strict": true,
        "target": "es6"
    },
    "include": ["src"]
}
