{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "baseUrl": "src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react",
        "lib": ["ESNext", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Node",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "paths": { "common/*": ["common/*"] },
        "rootDir": ".",
        "sourceMap": true,
        "strict": true,
        "target": "ESNext",
    },
    "include": ["src"],
    // Compile webpack.config.ts to cjs
    "ts-node": {
        "transpileOnly": true,
        "moduleTypes": {
            "webpack.config.ts": "cjs",
        }
    },
}
