{
    "name": "tight",
    "version": "0.0.1",
    "private": true,
    "packageManager": "npm@11.9.0",
    "exports": "./index.jsx",
    "scripts": {
        "clean:server": "rimraf ./build/server.js ./build/backend.js && rimraf ./build/hot",
        "clean:server:dev": "rimraf ./build/server-dev.js && rimraf ./build/server-dev.js.map",
        "clean:client": "rimraf ./dist",
        "clean": "npm run clean:server && npm run clean:server:dev && npm run clean:client",
        "build:server": "npm run clean:server && cross-env TARGET=node NODE_ENV=production webpack --config webpack.config.ts",
        "build:client": "npm run clean:client && cross-env TARGET=web NODE_ENV=production webpack --config webpack.config.ts",
        "build": "npm run build:server && npm run build:client",
        "start": "node ./build/server.js",
        "start:dev": "cross-env TARGET=node NODE_ENV=development node --watch --inspect ./build/server-dev.js",
        "server:dev": "cross-env TARGET=node NODE_ENV=development webpack --config webpack.config.ts",
        "server:debug": "cross-env TARGET=node NODE_ENV=development LOG_LEVEL=debug webpack --config webpack.config.ts",
        "client:dev": "cross-env TARGET=web NODE_ENV=development webpack --watch --config webpack.config.ts",
        "audit:runtime": "npm audit --omit=dev --audit-level=low",
        "test": "npm run build:server && node --test --test-concurrency=1 tests/*.test.mjs",
        "test:browser": "npm run build && npm run typecheck:browser && playwright test",
        "typecheck": "tsc --noEmit --project tsconfig.web.json && tsc --noEmit --project tsconfig.server.json",
        "typecheck:browser": "tsc --project tsconfig.tests.json",
        "build:desktop-backend": "cross-env TARGET=desktop NODE_ENV=production webpack --config webpack.config.ts",
        "build:desktop": "npm run build && npm run build:desktop-backend",
        "desktop": "npm run build:desktop && electron .",
        "test:desktop": "npm run build:desktop && playwright test --config=playwright.desktop.config.ts",
        "package:windows": "npm run build:desktop && node scripts/package-desktop.mjs win32",
        "installer:windows:preview": "npm run package:windows && node scripts/build-windows-installer.mjs preview",
        "installer:windows:release": "npm run build:desktop && node scripts/package-desktop.mjs win32 release && node scripts/build-windows-installer.mjs release"
    },
    "dependencies": {
        "@babel/runtime": "7.29.10",
        "@emotion/react": "11.11.4",
        "@emotion/styled": "11.11.0",
        "@loadable/component": "5.16.3",
        "@mui/icons-material": "5.15.12",
        "@mui/lab": "5.0.0-alpha.167",
        "@mui/material": "5.15.12",
        "@mui/styles": "5.15.12",
        "canvas-confetti": "1.9.3",
        "chalk": "5.3.0",
        "classnames": "2.5.1",
        "core-js": "3.36.0",
        "date-fns": "3.4.0",
        "express": "4.22.3",
        "lodash-es": "4.18.1",
        "qrcode.react": "4.2.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router-dom": "7.18.4",
        "regenerator-runtime": "0.14.1",
        "ws": "8.22.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@babel/core": "7.29.7",
        "@babel/preset-env": "7.24.0",
        "@babel/preset-react": "7.23.3",
        "@babel/preset-typescript": "7.23.3",
        "@electron/packager": "20.3.0",
        "@playwright/test": "1.64.1",
        "@types/canvas-confetti": "1.9.0",
        "@types/classnames": "2.3.0",
        "@types/core-js": "2.5.8",
        "@types/express": "4.17.21",
        "@types/loadable__component": "5.13.9",
        "@types/lodash-es": "4.17.12",
        "@types/node": "22.13.10",
        "@types/pngjs": "6.0.5",
        "@types/react": "18.2.64",
        "@types/react-dom": "18.2.21",
        "@types/webpack": "5.28.5",
        "@types/webpack-env": "1.18.4",
        "@types/ws": "8.5.10",
        "babel-loader": "9.1.3",
        "cross-env": "7.0.3",
        "electron": "45.0.0",
        "electron-builder": "26.15.3",
        "file-loader": "6.2.0",
        "html-webpack-plugin": "5.6.0",
        "jsqr": "1.4.0",
        "pngjs": "7.0.0",
        "rimraf": "5.0.5",
        "source-map-loader": "5.0.0",
        "ts-loader": "9.6.2",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "webpack": "5.112.0",
        "webpack-cli": "5.1.4",
        "webpack-node-externals": "3.0.0"
    },
    "sideEffects": false,
    "type": "module",
    "engines": {
        "node": ">=22.15.0"
    },
    "main": "desktop/main.cjs",
    "productName": "TIGHT",
    "description": "Twilight Imperium game helper and tracker",
    "overrides": {
        "app-builder-lib": {
            "@electron/get": "5.0.0"
        }
    }
}
