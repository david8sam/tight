{
    "name": "tight",
    "version": "0.0.1",
    "private": true,
    "exports": "./index.jsx",
    "scripts": {
        "clean:server": "rimraf ./build/server.js && rimraf ./build/hot",
        "clean:client": "rimraf ./dist",
        "clean": "npm run clean:server && npm run clean:client",
        "build:server": "npm run clean:server && cross-env NODE_ENV=production webpack --config webpack.config.ts",
        "build:client": "vite build",
        "build": "npm run build:server && npm run build:client",
        "start": "nodemon ./build/server.js",
        "start:dev": "cross-env NODE_ENV=development nodemon --inspect ./build/server-dev.js",
        "server:dev": "cross-env NODE_ENV=development webpack --config webpack.config.ts",
        "server:debug": "cross-env NODE_ENV=development LOG_LEVEL=debug webpack --config webpack.config.ts",
        "client:dev": "vite"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
