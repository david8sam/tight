{
    "name": "tight",
    "version": "0.0.1",
    "private": true,
    "main": "index.jsx",
    "scripts": {
        "clean:server": "rimraf ./build/server.js && rimraf ./build/hot",
        "clean:client": "rimraf ./dist",
        "clean": "npm run clean:server && npm run clean:client",
        "build:server": "npm run clean:server && cross-env TARGET=node NODE_ENV=production webpack --config webpack.config.js",
        "build:server:dev": "cross-env TARGET=node NODE_ENV=development webpack --config webpack.config.js",
        "build:client": "npm run clean:client && cross-env TARGET=web NODE_ENV=production webpack --config webpack.config.js",
        "build": "npm run build:server && npm run build:client",
        "server": "nodemon --exec node ./build/server.js",
        "server:dev": "cross-env TARGET=node NODE_ENV=development nodemon --exec node --inspect ./build/server-dev.js",
        "client:dev": "cross-env TARGET=web NODE_ENV=development webpack-dev-server --port 3001"
    },
    "dependencies": {
        "@babel/runtime": "7.16.3",
        "@loadable/component": "5.15.0",
