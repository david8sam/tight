{
    "name": "tight",
    "version": "0.0.1",
    "private": true,
    "exports": "./index.jsx",
    "scripts": {
        "clean:server": "rimraf ./build/server.js && rimraf ./build/hot",
        "clean:client": "rimraf ./dist",
        "clean": "npm run clean:server && npm run clean:client",
        "build:server": "npm run clean:server && cross-env TARGET=node NODE_ENV=production webpack --config webpack.config.ts",
        "build:client": "npm run clean:client && cross-env TARGET=web NODE_ENV=production webpack --config webpack.config.ts",
        "build": "npm run build:server && npm run build:client",
        "start": "nodemon ./build/server.js",
        "start:dev": "cross-env TARGET=node NODE_ENV=development nodemon --inspect ./build/server-dev.js",
        "server:dev": "cross-env TARGET=node NODE_ENV=development webpack --config webpack.config.ts",
        "server:debug": "cross-env TARGET=node NODE_ENV=development LOG_LEVEL=debug webpack --config webpack.config.ts",
        "client:dev": "cross-env TARGET=web NODE_ENV=development webpack-dev-server --port 3001"
    },
    "dependencies": {
        "@babel/runtime": "7.24.0",
        "@emotion/react": "11.11.4",
        "@emotion/styled": "11.11.0",
