        "@types/canvas-confetti": "1.9.0",
        "better-sqlite3": "^12.11.1",
        "canvas-confetti": "1.9.3",
        "chalk": "5.3.0",
        "classnames": "2.5.1",
        "cors": "2.8.5",
        "date-fns": "3.4.0",
        "express": "5.2.1",
        "ip": "2.0.1",
        "lodash-es": "4.17.21",
        "nodemon": "3.1.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router-dom": "7.18.0",
        "tss-react": "4.9.21",
