        "@types/cors": "2.8.17",
        "@types/express": "5.0.6",
        "@types/ip": "1.1.3",
        "@types/lodash-es": "4.17.12",
        "@types/node": "20.11.25",
        "@types/react": "18.2.64",
        "@types/react-dom": "18.2.21",
        "@types/webpack": "5.28.5",
        "@types/ws": "8.5.10",
