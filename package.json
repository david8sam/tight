        "core-js": "3.36.0",
        "cors": "2.8.5",
        "date-fns": "3.4.0",
        "express": "4.19.2",
        "ip": "2.0.1",
        "lodash-es": "4.17.21",
        "nodemon": "3.1.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-router-dom": "6.22.3",
        "regenerator-runtime": "0.14.1",
        "superagent": "8.1.2",
        "ws": "8.16.0"
    },
    "devDependencies": {
        "@babel/cli": "7.23.9",
        "@babel/core": "7.24.0",
        "@babel/preset-env": "7.24.0",
        "@babel/preset-react": "7.23.3",
        "@babel/preset-typescript": "7.23.3",
